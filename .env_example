# AES-256-CBC key (must be exactly 32 bytes)
KEY=07e983ed1676bbfa9d01f3ea7e23179c
# AES-CBC IV (must be exactly 16 bytes)
IV=40f38a55cb4fec35

# Maximum allowed requested dimensions
MAX_WIDTH=1024
MAX_HEIGHT=1024

# Compression level for re-encoded JPEG images (1-100)
IMAGE_QUALITY=100

# Route image origin requests through wsrv.nl to shrink the source image
COMPRESS_IMAGE=true

HOST=0.0.0.0
PORT=3000

# Bounded in-memory cache for processed images
CACHE_MAX_BYTES=67108864
CACHE_TTL_SECS=300

# Log verbosity (trace, debug, info, warn, error)
RUST_LOG=info
